{
  "manifest_version": 3,
  "name": "Puretomo Extentions",
  "version": "1.0.0",
  "description": "ハンゲPuretomo用の拡張機能を提供します",
  "permissions": [
    "downloads"
  ],
  "host_permissions": [
    "https://puretomo.hange.jp/*",
    "https://puretomo-image.hange.jp/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://puretomo.hange.jp/*",
        "https://puretomo-image.hange.jp/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
}
}